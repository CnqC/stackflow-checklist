# Kết nối Supabase Cloud để đồng bộ thời gian thực qua Internet giữa Web & Mobile App
# (Bạn cũng có thể nhập trực tiếp ngay trong phần "Cài đặt Đồng bộ Cloud" của ứng dụng)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public VAPID key for Web Push. The matching private key stays in Supabase secrets.
VITE_WEB_PUSH_PUBLIC_KEY=
